{
  "name": "overlay-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Universal overlay toolkit for web applications",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive --if-present run clean"
  },
  "keywords": [
    "overlay",
    "watermark",
    "logo",
    "badge",
    "branding",
    "typescript",
    "javascript",
    "react",
    "web"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
